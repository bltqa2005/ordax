# --- FACEIT Data API (server-side only, never expose to the browser) ---
# Server-side API key from https://developers.faceit.com (App > API keys > "Server side API key")
FACEIT_API_KEY=

# --- Optional tuning ---
# Seconds the server keeps fetched data before calling FACEIT again (default 300)
CACHE_TTL_SECONDS=300
# Parallel requests to FACEIT (default 3)
FACEIT_CONCURRENCY=3

# --- Persistent storage for ELO snapshots (history shared across devices) ---
# Option A (recommended on Vercel): Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B (VPS / Docker with a volume): directory for JSON files (default ./.data)
DATA_DIR=

# --- Admin / automation ---
# Needed to manually confirm a FACEIT profile for a player (POST /api/resolve)
ADMIN_TOKEN=
# Needed to call GET /api/cron (Authorization: Bearer <CRON_SECRET>) from a scheduler
CRON_SECRET=
